# Managed by Ansible (role hlm_agent). Local changes are overwritten.
HUB_URL={{ hlm_hub_url }}
TOKEN={{ _hlm_token }}
KEY={{ _hlm_key }}
{% if hlm_allow_insecure | bool %}
ALLOW_INSECURE=true
{% endif %}
{% if not hlm_auto_update | bool %}
AUTO_UPDATE=false
{% endif %}
{% if hlm_repo != 'midnights-ra1n/homelab-monitoring' %}
UPDATE_REPO={{ hlm_repo }}
{% endif %}
